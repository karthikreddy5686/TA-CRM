# ==============================================================================
# Domain Mail / SMTP Email Configuration (TalentConnect TA CRM)
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Google Workspace (e.g. yourname@yourcompany.com hosted on Google)
# ------------------------------------------------------------------------------
# Leave SMTP_HOST blank, and generate a 16-character Google App Password:
# https://myaccount.google.com/apppasswords
SMTP_USER=hr@yourcompany.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# OPTION 2: Custom Domain Mail (Zoho, Microsoft 365, Hostinger, cPanel, etc.)
# ------------------------------------------------------------------------------
# Uncomment and fill in your domain mail server details:
# SMTP_HOST=smtp.zoho.com        # e.g. smtp.zoho.com, smtp.office365.com, mail.yourdomain.com
# SMTP_PORT=465                  # 465 (SSL) or 587 (TLS)
# SMTP_SECURE=true               # true for 465, false for 587
# SMTP_USER=hr@yourcompany.com
# SMTP_PASS=your_email_or_app_password
